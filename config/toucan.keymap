#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define CONF     4
#define MOUSE    5
#define SPD_SLOW 6
#define SPD_FAST 7

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        // Cycle trackpad speed presets by tap count:
        //   1 tap  -> 0.5x  (spd_slow)
        //   2 taps -> 0.75x (base, no speed layer)
        //   3 taps -> 1.0x  (spd_fast)
        speed_td: speed_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&to SPD_SLOW>, <&to BASE>, <&to SPD_FAST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB  &kp Q  &kp W  &kp F  &kp P  &kp B  &kp J  &kp L  &kp U  &kp Y  &none  &kp CAPS  &kp LSHFT  &kp A  &kp R  &kp S  &kp T  &kp G  &kp M  &kp N  &kp E  &kp I  &kp O  &kp RET  &kp LGUI  &kp Z  &kp X  &kp C  &kp D  &kp V  &kp K  &kp H  &mo 3  &none  &kp LEFT  &kp RIGHT  &kp LCTRL  &mo 1  &kp SPACE  &kp BSPC  &mo 2  &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&kp LG(GRAVE)  &kp LC(GRAVE)  &kp LG(W)  &kp LG(F)  &kp LS(LG(F))  &none  &kp F3  &kp LG(LEFT_ARROW)  &kp PAGE_UP  &kp F4  &kp LS(LG(N0))  &kp LS(LG(X))  &trans  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCMD  &none  &kp F2  &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans  &kp LC(LS(F9))  &none  &none  &kp LC(LA(LG(N)))  &none  &kp F1  &kp LG(RIGHT_ARROW)  &kp PAGE_DOWN  &kp F7  &none  &kp LA(LS(O))  &none  &trans  &kp C_PLAY  &trans  &kp DELETE  &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&trans  &kp LS(EXCL)  &kp GRAVE  &kp MINUS  &kp LS(UNDER)  &kp LS(COLON)  &kp SEMI  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(AMPS)  &kp LS(CARET)  &trans  &trans  &kp LS(LT)  &kp LS(LBRC)  &kp LBKT  &kp LS(LPAR)  &kp SQT  &kp COMMA  &kp DOT  &kp LS(QMARK)  &kp LS(PIPE)  &kp LS(STAR)  &trans  &trans  &kp LS(GT)  &kp LS(RBRC)  &kp RBKT  &kp LS(RPAR)  &kp LS(DQT)  &kp LS(PLUS)  &kp EQUAL  &kp FSLH  &kp BSLH  &kp LS(PRCNT)  &trans  &trans  &kp ESCAPE  &kp SPACE  &trans  &trans  &trans
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
&trans  &none  &kp N1  &kp N2  &kp N3  &none  &none  &none  &none  &trans  &trans  &mo 4  &trans  &none  &kp N4  &kp N5  &kp N6  &kp DOT  &none  &none  &none  &none  &none  &none  &trans  &none  &kp N7  &kp N8  &kp N9  &none  &none  &none  &trans  &trans  &none  &none  &kp N0  &kp LEFT_COMMAND  &trans  &trans  &kp LEFT_SHIFT  &trans
            >;
        };

        conf {
            display-name = "CONF";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &speed_td  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &mkp MB5  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "MOUSE";
        };

        spd_slow {
            display-name = "S0.5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        spd_fast {
            display-name = "S1";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
